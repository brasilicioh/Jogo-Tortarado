join bibiana center
if {Ato2.interacted_with_belonisia_firsttime} == false:
	bibiana: Bom dia, irmã! Veio me chamar para os preparativos da festa do papai?
	bibiana: Falaram que virá muita gente, então temos que fazer um negócio bem bonito!
	do UiManager.set_current_task("Festa de Zeca: Itens da Festa")
	set {Ato2.interacted_with_belonisia_firsttime} = true
	[signal arg="move"]
elif {Ato2.interacted_with_belonisia_secondtime} == false:
	bibiana: Que bom que você anotou! A gente pega tudo isso e deixa aqui na mesa da sala, tá?
	set {Ato2.interacted_with_belonisia_secondtime} = true
	[signal arg="not"]